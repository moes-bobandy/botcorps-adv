constexpr uint16_t fit_pack332(int i)
{
    const int r3 = (i >> 5) & 7;
    const int g3 = (i >> 2) & 7;
    const int b2 = i & 3;
    const int r8 = (((r3 << 3) + r3) << 2) + (r3 >> 1);
    const int g8 = (((g3 << 3) + g3) << 2) + (g3 >> 1);
    const int b8 = b2 * 0x55;
    return (uint16_t)(((r8 & 0xF8) << 8) | ((g8 & 0xFC) << 3) | (b8 >> 3));
}
constexpr uint16_t fit_shown(int i)
{
    return k_is_res[i] ? k_exact_nat[i] : fit_pack332(i);
}
constexpr int fit_ch_r(uint16_t p)
{
    const int r5 = (p >> 11) & 31;
    return (r5 << 3) | (r5 >> 2);
}
constexpr int fit_ch_g(uint16_t p)
{
    const int g6 = (p >> 5) & 63;
    return (g6 << 2) | (g6 >> 4);
}
constexpr int fit_ch_b(uint16_t p)
{
    const int b5 = p & 31;
    return (b5 << 3) | (b5 >> 2);
}
constexpr int fit_dist2(uint16_t a, uint16_t b)
{
    const int dr = fit_ch_r(a) - fit_ch_r(b);
    const int dg = fit_ch_g(a) - fit_ch_g(b);
    const int db = fit_ch_b(a) - fit_ch_b(b);
    return dr * dr + dg * dg + db * db;
}
/* Worst dist2 of one displayed slot over the 16 RGB565 words in the bin.
 * Stops once the running worst is already past stop_at. */
constexpr int fit_bin_worst(int key, int slot, int stop_at)
{
    const int r4 = key >> 8;
    const int g4 = (key >> 4) & 15;
    const int b4 = key & 15;
    const uint16_t shown = fit_shown(slot);
    int worst = 0;
    for (int rl = 0; rl < 2; ++rl) {
        for (int gl = 0; gl < 4; ++gl) {
            for (int bl = 0; bl < 2; ++bl) {
                const uint16_t q = (uint16_t)(((r4 * 2 + rl) << 11) | ((g4 * 4 + gl) << 5) | (b4 * 2 + bl));
                const int d = fit_dist2(q, shown);
                if (d > worst) worst = d;
                if (worst >= stop_at) return worst;
            }
        }
    }
    return worst;
}
/* Bins whose chosen slot is strictly worse than another slot's worst case. */
constexpr int fit_not_minimax(int a, int b)
{
    int n = 0;
    for (int key = a; key < b; ++key) {
        const int slot = k_fit4[key];
        const int mine = fit_bin_worst(key, slot, 1000000);
        for (int i = 0; i < 256; ++i) {
            if (i == slot) continue;
            if (fit_bin_worst(key, i, mine) < mine) {
                ++n;
                break;
            }
        }
    }
    return n;
}
static_assert(fit_not_minimax(0, 512) == 0, "minimax 0");
static_assert(fit_not_minimax(512, 1024) == 0, "minimax 1");
static_assert(fit_not_minimax(1024, 1536) == 0, "minimax 2");
static_assert(fit_not_minimax(1536, 2048) == 0, "minimax 3");
static_assert(fit_not_minimax(2048, 2560) == 0, "minimax 4");
static_assert(fit_not_minimax(2560, 3072) == 0, "minimax 5");
static_assert(fit_not_minimax(3072, 3584) == 0, "minimax 6");
static_assert(fit_not_minimax(3584, 4096) == 0, "minimax 7");
/* Worst dist2 of the chosen slots. With fit_not_minimax == 0 this equals
 * the minimax floor: no other assignment of these slots can do better. */
constexpr int fit_chosen_worst(int a, int b)
{
    int w = 0;
    for (int key = a; key < b; ++key) {
        const int d = fit_bin_worst(key, k_fit4[key], 1000000);
        if (d > w) w = d;
    }
    return w;
}
static_assert(fit_chosen_worst(0, 512) == 4053, "minimax floor");
static_assert(fit_chosen_worst(512, 1024) <= 4053, "floor 1");
static_assert(fit_chosen_worst(1024, 1536) <= 4053, "floor 2");
static_assert(fit_chosen_worst(1536, 2048) <= 4053, "floor 3");
static_assert(fit_chosen_worst(2048, 2560) <= 4053, "floor 4");
static_assert(fit_chosen_worst(2560, 3072) <= 4053, "floor 5");
static_assert(fit_chosen_worst(3072, 3584) <= 4053, "floor 6");
static_assert(fit_chosen_worst(3584, 4096) <= 4053, "floor 7");
