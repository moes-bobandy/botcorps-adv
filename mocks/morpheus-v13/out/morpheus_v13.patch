+    for (int i = 0; i < 12; ++i) mo11_have[i] = false;
+    for (int n = 0; n < lv_rd_n; ++n) { const LvTower &T = lv_rd_tw[n]; if (T.i < 0 || T.i >= 12) continue; mo11_tw[T.i] = T; mo11_have[T.i] = true; MO_ORD[mo11_nord++] = T.i;
