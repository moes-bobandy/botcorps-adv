static_assert(sizeof(k_fit4) == 4096, "4-bit fit table");

constexpr uint16_t fit_pack332(int i)
{
    const int r3 = (i >> 5) & 7;
    const int g3 = (i >> 2) & 7;
    const int b2 = i & 3;
    const int r8 = (((r3 << 3) + r3) << 2) + (r3 >> 1);
    const int g8 = (((g3 << 3) + g3) << 2) + (g3 >> 1);
    const int b8 = b2 * 0x55;
    return (uint16_t)(((r8 & 0xF8) << 8) | ((g8 & 0xFC) << 3) | (b8 >> 3));
}

constexpr uint16_t fit_shown(int i)
{
    return k_is_res[i] ? k_exact_nat[i] : fit_pack332(i);
}

constexpr int fit_ch_r(uint16_t p)
{
    const int r5 = (p >> 11) & 31;
    return (r5 << 3) | (r5 >> 2);
}
constexpr int fit_ch_g(uint16_t p)
{
    const int g6 = (p >> 5) & 63;
    return (g6 << 2) | (g6 >> 4);
}
constexpr int fit_ch_b(uint16_t p)
{
    const int b5 = p & 31;
    return (b5 << 3) | (b5 >> 2);
}
constexpr int fit_dist2(uint16_t a, uint16_t b)
{
    const int dr = fit_ch_r(a) - fit_ch_r(b);
    const int dg = fit_ch_g(a) - fit_ch_g(b);
    const int db = fit_ch_b(a) - fit_ch_b(b);
    return dr * dr + dg * dg + db * db;
}

/* Same centre the generator used: bit-replicate the 4-bit key into RGB565. */
constexpr uint16_t fit_bin_centre(int key)
{
    const int r4 = key >> 8;
    const int g4 = (key >> 4) & 15;
    const int b4 = key & 15;
    const int r5 = (r4 << 1) | (r4 >> 3);
    const int g6 = (g4 << 2) | (g4 >> 2);
    const int b5 = (b4 << 1) | (b4 >> 3);
    return (uint16_t)((r5 << 11) | (g6 << 5) | b5);
}

constexpr int fit_not_nearest(int a, int b)
{
    int n = 0;
    for (int key = a; key < b; ++key) {
        const uint16_t c = fit_bin_centre(key);
        const int ds = fit_dist2(c, fit_shown(k_fit4[key]));
        for (int i = 0; i < 256; ++i) {
            if (fit_dist2(c, fit_shown(i)) < ds) {
                ++n;
                break;
            }
        }
    }
    return n;
}

static_assert(fit_not_nearest(0, 512) == 0, "bin centre nearest 0");
static_assert(fit_not_nearest(512, 1024) == 0, "bin centre nearest 1");
static_assert(fit_not_nearest(1024, 1536) == 0, "bin centre nearest 2");
static_assert(fit_not_nearest(1536, 2048) == 0, "bin centre nearest 3");
static_assert(fit_not_nearest(2048, 2560) == 0, "bin centre nearest 4");
static_assert(fit_not_nearest(2560, 3072) == 0, "bin centre nearest 5");
static_assert(fit_not_nearest(3072, 3584) == 0, "bin centre nearest 6");
static_assert(fit_not_nearest(3584, 4096) == 0, "bin centre nearest 7");
