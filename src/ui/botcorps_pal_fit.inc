static_assert(sizeof(k_fit4) == 4096, "4-bit fit table");

/* A reserved slot may own a bin only when its displayed colour is the nearest
 * to that bin's 16-word mean. Free codes are the plain RGB332 value. */
constexpr uint16_t fit_pack332(int i)
{
    const int r3 = (i >> 5) & 7;
    const int g3 = (i >> 2) & 7;
    const int b2 = i & 3;
    const int r8 = (((r3 << 3) + r3) << 2) + (r3 >> 1);
    const int g8 = (((g3 << 3) + g3) << 2) + (g3 >> 1);
    const int b8 = b2 * 0x55;
    return (uint16_t)(((r8 & 0xF8) << 8) | ((g8 & 0xFC) << 3) | (b8 >> 3));
}

constexpr uint16_t fit_shown(int i)
{
    return k_is_res[i] ? k_exact_nat[i] : fit_pack332(i);
}

constexpr int fit_ch_r(uint16_t p)
{
    const int r5 = (p >> 11) & 31;
    return (r5 << 3) | (r5 >> 2);
}
constexpr int fit_ch_g(uint16_t p)
{
    const int g6 = (p >> 5) & 63;
    return (g6 << 2) | (g6 >> 4);
}
constexpr int fit_ch_b(uint16_t p)
{
    const int b5 = p & 31;
    return (b5 << 3) | (b5 >> 2);
}

constexpr int fit_dist2(uint16_t a, uint16_t b)
{
    const int dr = fit_ch_r(a) - fit_ch_r(b);
    const int dg = fit_ch_g(a) - fit_ch_g(b);
    const int db = fit_ch_b(a) - fit_ch_b(b);
    return dr * dr + dg * dg + db * db;
}

struct fit_sum { int r, g, b; };

constexpr fit_sum fit_bin_sum(int key)
{
    const int r4 = key >> 8;
    const int g4 = (key >> 4) & 15;
    const int b4 = key & 15;
    int sr = 0;
    int sg = 0;
    int sb = 0;
    for (int rl = 0; rl < 2; ++rl) {
        for (int gl = 0; gl < 4; ++gl) {
            for (int bl = 0; bl < 2; ++bl) {
                const int r5 = r4 * 2 + rl;
                const int g6 = g4 * 4 + gl;
                const int b5 = b4 * 2 + bl;
                const uint16_t p = (uint16_t)((r5 << 11) | (g6 << 5) | b5);
                sr += fit_ch_r(p);
                sg += fit_ch_g(p);
                sb += fit_ch_b(p);
            }
        }
    }
    return { sr, sg, sb };
}

constexpr int fit_dmean(int i, fit_sum s)
{
    const uint16_t p = fit_shown(i);
    const int dr = fit_ch_r(p) * 16 - s.r;
    const int dg = fit_ch_g(p) * 16 - s.g;
    const int db = fit_ch_b(p) * 16 - s.b;
    return dr * dr + dg * dg + db * db;
}

constexpr bool fit_bin_ok(int key)
{
    const int slot = k_fit4[key];
    if (!k_is_res[slot]) return true;
    const fit_sum s = fit_bin_sum(key);
    int best = 0;
    int bestd = fit_dmean(0, s);
    for (int i = 1; i < 256; ++i) {
        const int d = fit_dmean(i, s);
        if (d < bestd) {
            bestd = d;
            best = i;
        }
    }
    return best == slot;
}

constexpr bool fit_bins_ok(int a, int b)
{
    for (int key = a; key < b; ++key) {
        if (!fit_bin_ok(key)) return false;
    }
    return true;
}

static_assert(fit_bins_ok(0, 512), "k_fit4 reserved bins 0");
static_assert(fit_bins_ok(512, 1024), "k_fit4 reserved bins 1");
static_assert(fit_bins_ok(1024, 1536), "k_fit4 reserved bins 2");
static_assert(fit_bins_ok(1536, 2048), "k_fit4 reserved bins 3");
static_assert(fit_bins_ok(2048, 2560), "k_fit4 reserved bins 4");
static_assert(fit_bins_ok(2560, 3072), "k_fit4 reserved bins 5");
static_assert(fit_bins_ok(3072, 3584), "k_fit4 reserved bins 6");
static_assert(fit_bins_ok(3584, 4096), "k_fit4 reserved bins 7");

constexpr int fit_worst_q(void)
{
    int worst = 0;
    int qworst = 0;
    for (int q = 0; q < 65536; ++q) {
        const uint16_t p = (uint16_t)q;
        const int r = (p >> 11) & 31;
        const int g = (p >> 5) & 63;
        const int b = p & 31;
        const int key = ((r >> 1) << 8) | ((g >> 2) << 4) | (b >> 1);
        const int d = fit_dist2(p, fit_shown(k_fit4[key]));
        if (d > worst) {
            worst = d;
            qworst = q;
        }
    }
    return qworst;
}

constexpr int fit_worst_d(void)
{
    const uint16_t p = (uint16_t)fit_worst_q();
    const int r = (p >> 11) & 31;
    const int g = (p >> 5) & 63;
    const int b = p & 31;
    const int key = ((r >> 1) << 8) | ((g >> 2) << 4) | (b >> 1);
    return fit_dist2(p, fit_shown(k_fit4[key]));
}

static_assert(fit_worst_q() == 0x140E, "worst k_fit4 input");
static_assert(fit_worst_d() == 3909, "worst k_fit4 dist2");
