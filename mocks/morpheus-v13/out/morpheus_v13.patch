+        const int dx2 = 2 * x - itw_fx0[i] - itw_fx1[i], dy = y < itw_hy0[i] ? itw_hy0[i] - y : y > itw_hy1[i] ? y - itw_hy1[i] : 0;
+        const long d = (long)dx2 * dx2 + 4L * dy * dy; if (d < bd) { bd = d; best = i; } }
