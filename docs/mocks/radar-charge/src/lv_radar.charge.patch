+    if (lv_rd_lock) return;   /* the button gives way to IGNORE / WATCH / HUNT exactly as today */
+    /* ---- the charge button ---- */
+    const LvRect &r = LV_RD_CG_BTN; const int w = r.x1 - r.x0 + 1, h = r.y1 - r.y0 + 1;
